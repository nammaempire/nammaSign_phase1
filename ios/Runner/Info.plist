<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>NammaSign</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>NammaSign</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(FLUTTER_BUILD_NAME)</string>
	<key>CFBundleSignature</key>
	<string>????</string>
	<key>CFBundleVersion</key>
	<string>$(FLUTTER_BUILD_NUMBER)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
		<key>UISceneConfigurations</key>
		<dict>
			<key>UIWindowSceneSessionRoleApplication</key>
			<array>
				<dict>
					<key>UISceneClassName</key>
					<string>UIWindowScene</string>
					<key>UISceneConfigurationName</key>
					<string>flutter</string>
					<key>UISceneDelegateClassName</key>
					<string>$(PRODUCT_MODULE_NAME).SceneDelegate</string>
					<key>UISceneStoryboardFile</key>
					<string>Main</string>
				</dict>
			</array>
		</dict>
	</dict>
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<!-- Required for FCM to deliver pushes while the app is suspended. -->
	<key>UIBackgroundModes</key>
	<array>
		<string>fetch</string>
		<string>remote-notification</string>
	</array>
	<key>FirebaseAppDelegateProxyEnabled</key>
	<true/>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<!-- Reversed iOS client ID from firebase_options.dart -->
				<!-- Needed by google_sign_in to complete the OAuth flow on iOS -->
				<string>com.googleusercontent.apps.1075476022217-hpbiuphm9988nca0rhkpjr60n7l9a7eh</string>
			</array>
		</dict>
	</array>

	<!--
		PRIVACY USAGE DESCRIPTIONS (App Store Review requirement)
		Apple rejects any submission that uses photo / camera / mic
		frameworks without an honest, specific reason string. Each line
		below is the exact text iOS shows when the system permission
		prompt appears. Keep them short, specific, and user-benefit
		focused — don't write "we need this to use the app".
	-->

	<key>NSPhotoLibraryUsageDescription</key>
	<string>NammaSign needs photo library access so you can upload your KYC documents (PAN, Aadhaar, CIN) and your ad creatives (images and videos) for the boards.</string>

	<key>NSCameraUsageDescription</key>
	<string>NammaSign uses the camera so you can take a fresh photo of your KYC document instead of digging through your photo library.</string>

	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>NammaSign saves your downloaded tax invoice to your photo library so you can keep a copy for your records.</string>

	<key>NSMicrophoneUsageDescription</key>
	<string>NammaSign does not record audio. This permission is requested only because the video playback framework declares a microphone capability.</string>

</dict>
</plist>
